{
  "name": "onera-worker",
  "compatibility_date": "2024-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development"
  },
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
